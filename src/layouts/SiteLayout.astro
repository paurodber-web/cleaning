  telephone: '+61 413 398 546',
  email: 'info@maidathome.com.au',
  contactType: 'customer service',
  areaServed: 'AU',
  availableLanguage: 'English',
};
const isHome = Astro.url.pathname === base || Astro.url.pathname === '/';
const normalisedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const breadcrumbNames: Record<string, string> = {
  '/': 'Home', '/services': 'Services', '/about-us': 'About us', '/pricing': 'Pricing',
  '/areas-we-serve': 'Areas we serve', '/faqs': 'FAQs', '/blog': 'Blog', '/contact': 'Contact',
};
const breadcrumbParts = normalisedPath.split('/').filter(Boolean);
const breadcrumbItems = [{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteOrigin).toString() }];
breadcrumbParts.forEach((_, index) => {
  const path = `/${breadcrumbParts.slice(0, index + 1).join('/')}`;
  const name = index === breadcrumbParts.length - 1 ? title.replace(/\s*\|.*$/, '') : (breadcrumbNames[path] ?? path.split('/').pop()!.replace(/-/g, ' '));
  breadcrumbItems.push({ '@type': 'ListItem', position: index + 2, name, item: new URL(`${path}/`, siteOrigin).toString() });
});
const inferredType = normalisedPath === '/about-us' ? 'AboutPage' : normalisedPath === '/contact' ? 'ContactPage' : 'WebPage';
const providedSchemas: Record<string, unknown>[] = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];
const providedNodes = providedSchemas.flatMap((schema) => {
  const graph = schema['@graph'];
  return Array.isArray(graph)
    ? graph.filter((node): node is Record<string, unknown> => typeof node === 'object' && node !== null)
    : [schema];
});
const providedTypes = new Set(providedNodes.flatMap((node) => {
  const type = node['@type'];
  if (Array.isArray(type)) return type.filter((value): value is string => typeof value === 'string');
  return typeof type === 'string' ? [type] : [];
}));
const hasProvidedPage = ['WebPage', 'AboutPage', 'ContactPage', 'ProfilePage', 'Article', 'BlogPosting'].some((type) => providedTypes.has(type));
const defaultGraph: Record<string, unknown>[] = [
  {
    '@type': 'Organization', '@id': organisationId, name: 'Maid At Home',
    url: new URL('/', siteOrigin).toString(), logo: new URL('/assets/logo-color.webp', siteOrigin).toString(),
    email: 'info@maidathome.com.au', telephone: '+61 413 398 546', foundingDate: '2017',
    areaServed: { '@type': 'City', name: 'Melbourne' }, sameAs: [googleProfile, instagramProfile],
    contactPoint,
    founder: [{ '@id': new URL('/about-us#pau', siteOrigin).toString() }, { '@id': new URL('/about-us#stefania', siteOrigin).toString() }],
  },
  {
    '@type': 'Person', '@id': new URL('/about-us#pau', siteOrigin).toString(), name: 'Pau',
    jobTitle: 'Co-founder, operations and customer experience', worksFor: { '@id': organisationId },
  },
  {
    '@type': 'Person', '@id': new URL('/about-us#stefania', siteOrigin).toString(), name: 'Stefania',
    jobTitle: 'Co-founder, cleaner care and training', worksFor: { '@id': organisationId },
  },
  {
    '@type': 'LocalBusiness', '@id': localBusinessId, name: 'Maid At Home',
    url: new URL('/', siteOrigin).toString(), image: new URL('/assets/logo-color.webp', siteOrigin).toString(),
    email: 'info@maidathome.com.au', telephone: '+61 413 398 546', foundingDate: '2017', priceRange: '$$',
    areaServed: { '@type': 'City', name: 'Melbourne' }, sameAs: [googleProfile, instagramProfile],
    contactPoint,
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['https://schema.org/Monday', 'https://schema.org/Tuesday', 'https://schema.org/Wednesday', 'https://schema.org/Thursday', 'https://schema.org/Friday', 'https://schema.org/Saturday'],
      opens: '09:00',
      closes: '17:00',
    },
    parentOrganization: { '@id': organisationId },
  },
];
if (!hasProvidedPage) defaultGraph.push({
  '@type': inferredType, '@id': `${pageUrl}#webpage`, url: pageUrl, name: title,
  description, isPartOf: { '@id': new URL('/#website', siteOrigin).toString() },
  about: { '@id': organisationId }, inLanguage: 'en-AU',
});
if (isHome && !providedTypes.has('WebSite')) defaultGraph.push({ '@type': 'WebSite', '@id': new URL('/#website', siteOrigin).toString(), url: new URL('/', siteOrigin).toString(), name: 'Maid At Home', publisher: { '@id': organisationId }, inLanguage: 'en-AU' });
if (normalisedPath.startsWith('/services/') && normalisedPath !== '/services' && !providedTypes.has('Service')) defaultGraph.push({ '@type': 'Service', '@id': `${pageUrl}#service`, name: title.replace(/\s*\|.*$/, ''), description, url: pageUrl, serviceType: 'House cleaning', provider: { '@id': localBusinessId }, areaServed: { '@type': 'City', name: 'Melbourne' } });
if (!isHome && !providedTypes.has('BreadcrumbList')) defaultGraph.push({ '@type': 'BreadcrumbList', itemListElement: breadcrumbItems });
const defaultSchema = { '@context': 'https://schema.org', '@graph': defaultGraph };
const schemaBlocks = [defaultSchema, ...providedSchemas];
// Analytics is managed exclusively through this container, so page views and events are not duplicated.
const gtmId = 'GTM-W9TCF2NW';
const faqLayoutStyles = `@media(min-width:821px){.faq-layout,.coverage-layout{grid-template-columns:.9fr 1.1fr!important;gap:clamp(42px,6vw,78px)!important}}.coverage-grid .coverage-card:nth-child(1){order:1}.coverage-grid .coverage-card:nth-child(5){order:2}.coverage-grid .coverage-card:nth-child(2){order:3}.coverage-grid .coverage-card:nth-child(3){order:4}.coverage-grid .coverage-card:nth-child(4){order:5}.coverage-grid .coverage-card:nth-child(6){order:6}#contact-options{padding-bottom:clamp(46px,5vw,72px)!important}#whatsapp{padding-top:clamp(46px,5vw,72px)!important}.wa-priority-icon{display:none!important}`;
const howItWorksStyles = `.unified-how{position:relative!important;overflow:hidden!important;background:#fff!important}.unified-how:after{content:""!important;position:absolute!important;right:-120px!important;bottom:-180px!important;display:block!important;width:380px!important;height:380px!important;border-radius:50%!important;background:#f4fafc!important;pointer-events:none!important}.unified-how :is(.shell,.regular-shell){position:relative;z-index:1}.unified-how :is(.section-intro,.section-head,.regular-heading){display:grid!important;grid-template-columns:minmax(0,1.2fr) minmax(280px,.65fr)!important;align-items:end!important;gap:44px!important;margin-bottom:clamp(48px,6vw,72px)!important}.unified-how :is(.section-intro,.section-head,.regular-heading) h2{max-width:760px!important;margin:0!important;font-size:clamp(2.2rem,4.5vw,3.75rem)!important;font-weight:650!important;line-height:1.04!important;letter-spacing:-.045em!important;text-wrap:balance}.unified-how :is(.section-intro,.section-head,.regular-heading)>p{max-width:470px!important;margin:0 0 5px!important;color:#526978!important;font-size:1rem!important;line-height:1.6!important;text-wrap:pretty}.unified-how :is(.process-grid,.regular-steps){display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;align-items:start!important;gap:14px!important;padding-bottom:34px!important;counter-reset:unified-step!important}.unified-how :is(.process-step,.regular-step,.step){position:relative!important;display:block!important;min-height:285px!important;margin:0!important;padding:30px!important;border:1px solid #cfe7f3!important;border-radius:22px!important;background:#f4fafc!important;box-shadow:0 12px 28px rgba(29,80,119,.055)!important;counter-increment:unified-step!important;transition:transform .35s cubic-bezier(.22,1,.36,1),border-color .35s,box-shadow .35s!important}.unified-how :is(.process-step,.regular-step,.step):nth-child(even){margin-top:34px!important;background:#fff!important}.unified-how :is(.process-step,.regular-step,.step):hover{border-color:#a9d1e7!important;box-shadow:0 16px 36px rgba(29,80,119,.1)!important;transform:translateY(-5px)!important}.unified-how :is(.process-step,.regular-step,.step):after{display:none!important}.unified-how :is(.process-step__num,.process-num,.regular-step__label){display:flex!important;width:auto!important;height:auto!important;align-items:center!important;gap:12px!important;margin:0 0 32px!important;padding:0!important;border:0!important;border-radius:0!important;color:#3d86b9!important;background:transparent!important;font-family:"DM Sans",Arial,sans-serif!important;font-size:.72rem!important;font-weight:800!important;letter-spacing:.06em!important;line-height:1.2!important;text-transform:none!important}.unified-how :is(.process-step__num,.process-num,.regular-step__label):before{content:"0" counter(unified-step)!important;display:grid!important;width:62px!important;height:62px!important;flex:0 0 62px!important;place-items:center!important;border:0!important;border-radius:50%!important;color:#1d5077!important;background:#e8f5fb!important;font-family:"Plus Jakarta Sans",Arial,sans-serif!important;font-size:.8rem!important;font-weight:800!important;letter-spacing:0!important;line-height:1!important}.unified-how :is(.process-step,.regular-step,.step) h3{margin:0 0 10px!important;color:#183042!important;font-size:1.12rem!important;font-weight:650!important;line-height:1.25!important;letter-spacing:-.035em!important}.unified-how :is(.process-step,.regular-step,.step) p{max-width:100%!important;margin:0!important;color:#526978!important;font-size:.77rem!important;line-height:1.58!important;text-wrap:pretty}@media(max-width:1040px){.unified-how :is(.process-grid,.regular-steps){grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:14px!important}.unified-how :is(.process-step,.regular-step,.step):nth-child(even){margin-top:24px!important}}@media(max-width:820px){.unified-how :is(.section-intro,.section-head,.regular-heading){grid-template-columns:1fr!important;gap:12px!important}.unified-how :is(.section-intro,.section-head,.regular-heading)>p{max-width:580px!important}.unified-how :is(.process-step,.regular-step,.step){min-height:250px!important}}@media(max-width:620px){.unified-how:after{right:-170px!important;bottom:-210px!important}.unified-how :is(.process-grid,.regular-steps){grid-template-columns:1fr!important;gap:14px!important;padding-bottom:0!important}.unified-how :is(.process-step,.regular-step,.step),.unified-how :is(.process-step,.regular-step,.step):nth-child(even){min-height:0!important;margin-top:0!important;padding:25px!important}.unified-how :is(.process-step__num,.process-num,.regular-step__label){margin-bottom:24px!important}.unified-how :is(.process-step__num,.process-num,.regular-step__label):before{width:42px!important;height:42px!important;flex-basis:42px!important}}@media(prefers-reduced-motion:reduce){.unified-how :is(.process-step,.regular-step,.step){transition-duration:.01ms!important}}.dropdown-menu{width:auto!important;min-width:0!important;padding:8px 10px!important;grid-template-columns:repeat(2,max-content)!important;column-gap:14px!important;row-gap:0!important}.dropdown-menu a{padding:7px 8px!important;margin:0!important;width:auto!important}`;
const logoStyles = `.brand__logo{display:block!important;width:48px!important;height:48px!important;flex:0 0 48px!important;max-width:none!important;aspect-ratio:1/1!important;contain-intrinsic-size:44px 44px!important;object-fit:contain!important;border-radius:10px!important}.brand__name{display:inline-block!important;color:#366c90!important;white-space:nowrap!important}.footer-brand .brand{min-height:48px!important}.footer-brand .brand__name{font-family:"Plus Jakarta Sans",Arial,sans-serif!important;font-weight:800!important}.brand__logo--switcher{position:relative!important}.brand__logo-image{position:absolute!important;inset:0!important;display:block!important;width:100%!important;height:100%!important;max-width:none!important;object-fit:contain!important;transition:opacity .2s ease}.brand__logo-image--light{opacity:0}body.home-page:not(.menu-open) .site-header:not(.is-scrolled):not(.scrolled) .brand__logo-image--default{opacity:0}body.home-page:not(.menu-open) .site-header:not(.is-scrolled):not(.scrolled) .brand__logo-image--light{opacity:1}body.home-page:not(.menu-open) .site-header:not(.is-scrolled):not(.scrolled) .brand__name{color:#fff!important}@media(max-width:640px){.brand__logo{width:42px!important;height:42px!important;flex-basis:42px!important}.footer-brand .brand{min-height:42px!important}}`;
const mobileConversionStyles = `@media(max-width:760px){body{padding-bottom:calc(76px + env(safe-area-inset-bottom,0px))}.mobile-conversion-bar{position:fixed;z-index:80;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));left:12px;display:grid;grid-template-columns:minmax(0,1fr) 52px;gap:8px;align-items:center;padding:8px;border:1px solid rgba(24,48,66,.12);border-radius:18px;background:rgba(255,255,255,.96);box-shadow:0 12px 32px rgba(24,48,66,.2);backdrop-filter:blur(12px);transition:opacity .65s cubic-bezier(.22,1,.36,1),transform .65s cubic-bezier(.22,1,.36,1)}.mobile-conversion-bar a{min-height:48px;display:inline-flex;align-items:center;justify-content:center;border-radius:12px;font-weight:800;text-decoration:none}.mobile-conversion-bar__price{padding:0 14px;color:#183042;background:#f7dc87}.mobile-conversion-bar__whatsapp{border-radius:12px!important;background:#25d366}.mobile-conversion-bar__whatsapp svg{width:24px;height:24px;fill:#fff}.mobile-conversion-bar.is-hidden{opacity:0;pointer-events:none;transform:translateY(28px)}body.menu-open .mobile-conversion-bar{display:none}body.home-page .hero__actions a[href="#price-calculator"]{display:none!important}}@media(min-width:761px){.mobile-conversion-bar{display:none}}@media(prefers-reduced-motion:reduce){.mobile-conversion-bar{transition:none}}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7fbfd" />
    <meta name="description" content={description} />
    <meta name="robots" content={effectiveRobots} />
    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Maid At Home" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Maid At Home house cleaning services in Melbourne" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {schemaBlocks.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />)}
    <script is:inline define:vars={{ gtmId }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
    </script>
    <link rel="icon" type="image/png" href={`${base}assets/favicon.png?v=2`} />
    <link rel="preload" href={`${base}assets/logo.webp`} as="image" type="image/webp" />
    {bodyClass.includes('home-page') && <link rel="preload" href={`${base}assets/logo-white.webp`} as="image" type="image/webp" />}
    <link rel="preload" href={`${base}fonts/dm-sans-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/dm-sans-latin-ext.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/plus-jakarta-sans-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/plus-jakarta-sans-latin-ext.woff2`} as="font" type="font/woff2" crossorigin />
    {styles && <style is:inline set:html={styles} />}
    <style is:inline set:html={sharedStyles} />
    <style is:inline set:html={logoStyles} />
    <style is:inline set:html={mobileConversionStyles} />
    <style is:inline set:html={faqLayoutStyles} />
    <style is:inline set:html={howItWorksStyles} />
    <script is:inline>
      (() => {
        const titles = {
          '/services/standard-clean': 'Standard Clean<br>FAQs, answered.',
          '/services/regular-house-cleaning': 'Regular Clean<br>FAQs, answered.',
          '/services/deep-clean': 'Deep Clean<br>FAQs, answered.',
          '/services/hourly-clean': 'Hourly Clean<br>FAQs, answered.',
          '/services/move-in-clean': 'Move-In Clean<br>FAQs, answered.',
          '/services/carpet-clean': 'Carpet Clean<br>FAQs, answered.',
          '/services/end-of-lease-clean': 'End of Lease Clean<br>FAQs, answered.',
          '/services/oven-clean': 'Oven Clean<br>FAQs, answered.'
        };
        const update = () => {
          const heading = document.querySelector('.faq-intro h2');
          const title = titles[window.location.pathname.replace(/\/$/, '')];
          if (heading && title) heading.innerHTML = title;
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', update);
        else update();
      })();
    </script>
    <script is:inline>
      (() => {
        window.dataLayer = window.dataLayer || [];
        const send = (event, details = {}) => window.dataLayer.push({ event, ...details });
        document.addEventListener('click', (event) => {
          const link = event.target.closest?.('a');
          if (!link) return;
          const href = link.getAttribute('href') || '';
          if (href.startsWith('tel:')) send('phone_click', { link_url: href });
          if (href.startsWith('mailto:')) send('email_click', { link_url: href });
          if (href.includes('wa.me/')) send('whatsapp_click', { link_url: href });
          if (href.includes('share.google/')) send('google_profile_click', { link_url: href });
          if (href.includes('instagram.com/maidathome_melb')) send('instagram_click', { link_url: href });
          if (href.includes('/booking') || href.includes('bookingkoala.com')) send('booking_start', { link_url: href });
        });
        document.addEventListener('submit', (event) => {
          if (event.target?.id === 'contactForm') send('contact_form_submit');
        });
        const calculator = document.querySelector('#calculator, .calculator');
        if (calculator) {
          let started = false;
          calculator.addEventListener('input', () => { if (!started) { started = true; send('calculator_start'); } }, { passive: true });
          calculator.addEventListener('submit', () => send('calculator_complete'));
        }
        window.addEventListener('message', (event) => {
          if (!String(event.origin).includes('bookingkoala.com')) return;
          const message = JSON.stringify(event.data || '').toLowerCase();
          if (message.includes('complete') || message.includes('confirmed')) send('booking_complete');
        });
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    {skipLink && <a class="skip-link" href="#main-content">Skip to content</a>}
    {preHeader && <Fragment set:html={preHeader} />}
    <Header currentPath={currentPath} legacy={legacyHeader} lightLogo={bodyClass.includes('home-page')} />
    <slot />
    <Footer currentPath={currentPath} yearId={yearId} />
    {!['/pricing', '/booking'].includes(normalisedPath) && <aside class="mobile-conversion-bar is-hidden" id="mobileConversionBar" aria-label="Quick booking actions"><a class="mobile-conversion-bar__price" href="/pricing#calculator">Get an instant price</a><a class="mobile-conversion-bar__whatsapp" href="https://wa.me/61413398546?text=Hi%2C%20I%27d%20like%20to%20book%20a%20clean%20in%20Melbourne." target="_blank" rel="noopener noreferrer" aria-label="Chat with Maid At Home on WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.198-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg></a></aside>}
    <script is:inline>
      (() => {
        const bar = document.querySelector('#mobileConversionBar');
        const footer = document.querySelector('footer');
        if (!bar || !footer) return;
        let footerVisible = false;
        const updateVisibility = () => {
          const editing = Boolean(document.querySelector('input:focus, select:focus, textarea:focus'));
          bar.classList.toggle('is-hidden', footerVisible || editing || window.scrollY < 160);
        };
        new IntersectionObserver(([entry]) => { footerVisible = entry.isIntersecting; updateVisibility(); }, { threshold: 0.05 }).observe(footer);
        window.addEventListener('scroll', updateVisibility, { passive: true });
        document.addEventListener('focusin', updateVisibility);
        document.addEventListener('focusout', updateVisibility);
        updateVisibility();
      })();
    </script>    {scripts && <Fragment set:html={scripts} />}
  </body>
</html>
