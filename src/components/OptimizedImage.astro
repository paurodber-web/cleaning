---
import { Image, getImage } from 'astro:assets';
import cleanerHero from '../../assets-src/cleaner-hero.png';
import homeHero from '../../assets-src/home-hero.png';
import homeCarpet from '../../assets-src/home-carpet.png';
import homeRegular from '../../assets-src/home-regular.png';
import homeEndLease from '../../assets-src/home-end-lease.png';
import aboutCare from '../../assets-src/about-care.png';
import aboutResult from '../../assets-src/about-result.png';
import aboutCareKitchen from '../../assets-src/generated/about/about-care-kitchen.webp';
import aboutResultKitchen from '../../assets-src/generated/about/about-result-kitchen.webp';
import globalCta from '../../assets-src/global-cta.png';
import servicesHero from '../../assets-src/services-hero.png';
import cleanerKitchen from '../../assets-src/cleaner-kitchen.png';
import emptyMelbourneHome from '../../assets-src/empty-melbourne-home.png';
import carpetSpecialist from '../../assets-src/carpet-specialist.png';
import cleanerKitchenService from '../../assets-src/cleaner-kitchen-service.png';
import cleanerBathroomService from '../../assets-src/cleaner-bathroom-service.png';
import endOfLeaseService from '../../assets-src/end-of-lease-service.png';
import steamMopService from '../../assets-src/steam-mop-service.png';
import standardCleanService from '../../assets-src/generated/services/standard-clean.png';
import deepCleanService from '../../assets-src/generated/services/deep-clean.png';
import endOfLeaseCleanService from '../../assets-src/generated/services/end-of-lease-clean.png';
import regularCleanService from '../../assets-src/generated/services/regular-clean.webp';
import carpetHome from '../../assets-src/generated/home/steam-clean.webp';
import endLeaseLanding from '../../assets-src/generated/home/end-of-lease-inspection.webp';
import finalCta from '../../assets-src/generated/home/final-cta.webp';
import suburbWhy from '../../assets-src/generated/suburbs/why-maid-at-home.png';
import suburbFinalCta from '../../assets-src/generated/suburbs/suburb-final-cta.png';
import suburbCbd from '../../assets-src/generated/suburbs/suburb-cbd.png';
import suburbCbdTimeout from '../../assets-src/generated/suburbs/melbourne-cbd.webp';
import suburbVictorian from '../../assets-src/generated/suburbs/suburb-victorian.png';
import suburbLeafy from '../../assets-src/generated/suburbs/suburb-leafy.png';
import suburbBayside from '../../assets-src/generated/suburbs/suburb-bayside.png';
import suburbWaterside from '../../assets-src/generated/suburbs/suburb-waterside.png';

interface Props {
  src?: any;
  mobileSrc?: any;
  mobileBreakpoint?: string;
  mobileAspectRatio?: number;
  mobilePosition?: string;
  alt?: string;
  width?: number;
  height?: number;
  loading?: string;
  fetchpriority?: string;
  [key: string]: unknown;
}

const { src = '', mobileSrc, mobileBreakpoint = '620px', mobileAspectRatio = 390 / 844, mobilePosition = 'center', alt = '', width, height, loading, fetchpriority, ...attributes } = Astro.props;
const priority = fetchpriority === 'high';
const localImageMap: Record<string, unknown> = {
  '/assets/cleaner-hero.png': cleanerHero,
    '/assets/home-hero.png': homeHero,
    '/assets/home-carpet.png': homeCarpet,
    '/assets/home-regular.png': homeRegular,
    '/assets/home-end-lease.png': homeEndLease,
    '/assets/about-care.png': aboutCare,
    '/assets/about-result.png': aboutResult,
    '/assets/generated/about/about-care-kitchen.webp': aboutCareKitchen,
    '/assets/generated/about/about-result-kitchen.webp': aboutResultKitchen,
    '/assets/global-cta.png': globalCta,
    '/assets/services-hero.png': servicesHero,
  '/assets/cleaner-kitchen.png': cleanerKitchen,
  '/assets/empty-melbourne-home.png': emptyMelbourneHome,
  '/assets/carpet-specialist.png': carpetSpecialist,
    '/assets/cleaner-kitchen-service.png': cleanerKitchenService,
    '/assets/cleaner-bathroom-service.png': cleanerBathroomService,
    '/assets/end-of-lease-service.png': endOfLeaseService,
    '/assets/steam-mop-service.png': steamMopService,
    '/assets/generated/services/standard-clean.png': standardCleanService,
    '/assets/generated/services/deep-clean.png': deepCleanService,
    '/assets/generated/services/end-of-lease-clean.png': endOfLeaseCleanService,
    '/assets/generated/services/regular-clean.webp': regularCleanService,
    '/assets/generated/home/steam-clean.webp': carpetHome,
    '/assets/generated/home/end-of-lease-inspection.webp': endLeaseLanding,
    '/assets/generated/home/final-cta.webp': finalCta,
    '/assets/generated/suburbs/why-maid-at-home.png': suburbWhy,
    '/assets/generated/suburbs/suburb-final-cta.png': suburbFinalCta,
    '/assets/generated/suburbs/suburb-cbd.png': suburbCbd,
    '/assets/generated/suburbs/melbourne-cbd.webp': suburbCbdTimeout,
    '/assets/generated/suburbs/suburb-victorian.png': suburbVictorian,
    '/assets/generated/suburbs/suburb-leafy.png': suburbLeafy,
    '/assets/generated/suburbs/suburb-bayside.png': suburbBayside,
    '/assets/generated/suburbs/suburb-waterside.png': suburbWaterside,
};
const resolvedSrc = typeof src === 'string' && localImageMap[src] ? localImageMap[src] : src;
const dimensions = width && height ? { width, height } : { inferSize: true };
const imageSrc = resolvedSrc;
const safeLoading = loading === 'lazy' ? 'lazy' : undefined;
const quality = priority ? 40 : 60;
const isUnsplash = typeof src === 'string' && src.includes('images.unsplash.com/');
const sourceWidth = Number(width) || 1200;
const responsiveWidths = [...new Set([320, 480, 640, 768, 960, 1200, sourceWidth])]
  .filter((candidate) => candidate > 0 && candidate <= sourceWidth && (!priority || candidate <= 1200))
  .sort((a, b) => a - b);
const unsplashUrl = (candidate: number) => {
  const url = new URL(src as string);
  url.searchParams.set('auto', 'format');
  url.searchParams.set('fit', 'crop');
  url.searchParams.set('fm', 'webp');
  url.searchParams.set('q', String(quality));
  url.searchParams.set('w', String(candidate));
  return url.toString();
};
const unsplashSrcset = isUnsplash
  ? responsiveWidths.map((candidate) => `${unsplashUrl(candidate)} ${candidate}w`).join(', ')
  : '';
const responsiveSizes = priority
  ? '(max-width: 820px) calc(100vw - 30px), 50vw'
  : '(max-width: 820px) calc(100vw - 30px), 40vw';
const mobileSourceWidth = mobileSrc && typeof mobileSrc === 'object' && 'width' in mobileSrc ? Number(mobileSrc.width) : 0;
const mobileSourceHeight = mobileSrc && typeof mobileSrc === 'object' && 'height' in mobileSrc ? Number(mobileSrc.height) : 0;
const mobileMaxWidth = mobileSourceHeight ? Math.min(mobileSourceWidth, Math.floor(mobileSourceHeight * mobileAspectRatio)) : mobileSourceWidth;
const mobileWidths = [...new Set([390, 640, 750, 828, mobileMaxWidth])]
  .filter((candidate) => candidate > 0 && (!mobileMaxWidth || candidate <= mobileMaxWidth))
  .sort((a, b) => a - b);
const mobileCandidates = mobileSrc
  ? await Promise.all(mobileWidths.map(async (candidate) => ({
      width: candidate,
      image: await getImage({ src: mobileSrc, width: candidate, height: Math.round(candidate / mobileAspectRatio), fit: 'cover', position: mobilePosition, quality, format: 'webp' }),
    })))
  : [];
const mobileSrcset = mobileCandidates.map(({ width: candidate, image }) => image.src + ' ' + candidate + 'w').join(', ');
---
{isUnsplash && !mobileSrc ? (
  <img
    src={unsplashUrl(sourceWidth)}
    srcset={unsplashSrcset}
    sizes={responsiveSizes}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : safeLoading}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
    {...attributes}
  />
) : mobileSrc ? (
  <picture>
    <source media={'(max-width: ' + mobileBreakpoint + ')'} srcset={mobileSrcset} sizes="100vw" type="image/webp" />
    <Image
    src={imageSrc}
    alt={alt}
    {...dimensions}
    widths={priority ? responsiveWidths : undefined}
    sizes={priority ? responsiveSizes : undefined}
    quality={quality}
    priority={priority}
    loading={priority ? 'eager' : safeLoading}
    {...attributes}
  />
  </picture>
) : (
  <Image
    src={imageSrc}
    alt={alt}
    {...dimensions}
    widths={priority ? responsiveWidths : undefined}
    sizes={priority ? responsiveSizes : undefined}
    quality={quality}
    priority={priority}
    loading={priority ? 'eager' : safeLoading}
    {...attributes}
  />
)}









