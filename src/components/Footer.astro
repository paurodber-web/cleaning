const logoMarkup = '<img class="brand__logo" src="/assets/logo-color-96.webp" width="96" height="96" alt="" loading="lazy" decoding="async">';
const datedMarkup = markup.replace('id=\"year\"', `id=\"${yearId}\"`).replace(/<span class="brand__mark brand-mark" aria-hidden="true">.*?<\/span>/g, logoMarkup).replace('<span>Maid At Home</span>', '<span class="brand__name">Maid At Home</span>');
const withoutCurrent = datedMarkup.replace(/\saria-current=(['"])page\1/g, '');
const current = currentPath.replace(/\/+$/, '') || '/index.html';
const html = withoutCurrent.replace(new RegExp('(href=([\"\'])' + current + '\\2)', 'g'), '$1 aria-current=\"page\"');
const basedHtml = html.replace(/(href|src)=([\"\'])\/(?!\/)/g, '$1=$2' + base);
---
<Fragment set:html={basedHtml} />
<style is:global>
  footer .footer-brand .brand { z-index: 0; }
</style>
