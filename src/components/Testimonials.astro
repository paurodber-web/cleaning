---
const googleProfile = "https://share.google/qCmogE26ZAerwedX6";
---

<section class="section testimonials" id="testimonials" aria-labelledby="reviews-title">
  <div class="shell">
    <div class="review-heading-row reveal">
      <div>
        <div class="section-kicker">Customer stories</div>
        <h2 id="reviews-title">Why Melbourne families love coming home.</h2>
      </div>
      <div class="google-proof">
        <span class="google-g" aria-hidden="true"><img src="/assets/google-icon-logo-svgrepo-com.svg" width="22" height="22" alt="" loading="lazy" /></span>
        <span><strong>Feedback on Google</strong><a href={googleProfile} target="_blank" rel="noopener noreferrer">View our Google profile <span aria-hidden="true"></span></a></span>
      </div>
    </div>
    <div class="reviews-grid reveal">
      <article class="review-card"><div class="review-stars" aria-label="Five out of five stars">★★★★★</div><blockquote>"Amazing experience with Maid at Home - super professional, great communication, and my place looks spotless. Highly recommend if you want reliable service with zero hassle!"</blockquote><div class="review-person"><span><strong>Erin</strong><span>Melbourne - Home cleaning</span></span><a class="review-source review-verify" href="https://share.google/qCmogE26ZAerwedX6" target="_blank" rel="noopener noreferrer">Verify review on Google</a></div></article>
      <article class="review-card"><div class="review-stars" aria-label="Five out of five stars">★★★★★</div><blockquote>"Great team. We have been using Maid at Home for over 2.5 years. They are fabulous, our house is always spotless after they have been here. I would highly recommend them."</blockquote><div class="review-person"><span><strong>Anna</strong><span>Melbourne - Regular clean</span></span><a class="review-source review-verify" href="https://share.google/qCmogE26ZAerwedX6" target="_blank" rel="noopener noreferrer">Verify review on Google</a></div></article>
      <article class="review-card"><div class="review-stars" aria-label="Five out of five stars">★★★★★</div><blockquote>"We were so happy with our recent deep clean! Stefania and her partner did a perfect job getting our house ready for real estate photos. They went above and beyond."</blockquote><div class="review-person"><span><strong>Elly</strong><span>Melbourne - Deep clean</span></span><a class="review-source review-verify" href="https://share.google/qCmogE26ZAerwedX6" target="_blank" rel="noopener noreferrer">Verify review on Google</a></div></article>
    </div>
  </div>
</section>

<style>.section-kicker{display:flex;align-items:center;gap:10px;margin-bottom:19px;color:var(--blue-700,var(--b700));font-size:.76rem;font-weight:800;letter-spacing:.14em;line-height:1;text-transform:uppercase}.section-kicker::before{content:"";width:26px;height:2px;background:currentColor}
.testimonials{padding:clamp(84px,9vw,126px) 0;background:var(--white)}.review-heading-row{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:43px}.review-heading-row h2{max-width:650px;margin:0;font-size:clamp(2rem,4vw,3.35rem);line-height:1.08}.google-proof{display:flex;align-items:center;gap:12px;color:var(--blue-800,var(--b800));font-size:.72rem;font-weight:800}.google-proof .google-g{display:grid;width:42px;height:42px;flex:0 0 auto;place-items:center;border:1px solid var(--blue-200,var(--b200));border-radius:50%;background:var(--white)}.google-g img{display:block;width:22px;height:22px;object-fit:contain}.google-proof strong,.google-proof a{display:block}.google-proof a{margin-top:2px;color:var(--blue-700,var(--b700));font-size:.65rem}.google-proof a span[aria-hidden="true"]{display:inline;width:auto;height:auto;border:0;border-radius:0;background:transparent}.reviews-grid{display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:repeat(2,auto);gap:15px}.review-card{display:flex;min-height:190px;grid-column:8/-1;padding:27px;border:1px solid var(--blue-200,var(--b200));border-radius:20px;flex-direction:column;background:var(--white)}.review-card:first-child{min-height:395px;grid-column:1/8;grid-row:1/3;padding:clamp(30px,4vw,47px);color:var(--white);background:var(--blue-900,var(--b900))}.review-stars{margin-bottom:24px;color:#d5a82c;font-size:.78rem;letter-spacing:3px}.review-card blockquote{margin:0 0 28px;color:var(--ink);font:600 1rem/1.55 "Plus Jakarta Sans",Arial,sans-serif;letter-spacing:-.025em}.review-card:first-child blockquote{margin:auto 0;color:var(--white);font-size:clamp(1.35rem,2.5vw,2rem)}.review-person{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-top:auto;padding-top:20px;border-top:1px solid var(--blue-200,var(--b200))}.review-card:first-child .review-person{border-color:rgba(255,255,255,.18)}.review-person strong,.review-person span>span{display:block}.review-person strong{font-size:.72rem}.review-person span>span{margin-top:3px;color:var(--ink-soft,var(--soft));font-size:.65rem}.review-card:first-child .review-person span>span{color:var(--blue-200,var(--b200))}.review-source{color:var(--blue-700,var(--b700));font-size:.62rem;font-weight:800;text-transform:uppercase}.review-card:first-child .review-source{color:var(--beige)}@media(max-width:820px){.reviews-grid{grid-template-columns:1fr}.review-card,.review-card:first-child{min-height:250px;grid-column:auto;grid-row:auto}.review-heading-row{align-items:flex-start;flex-direction:column}.google-proof{padding-bottom:0}}@media(max-width:620px){.testimonials{padding-block:82px}}
.reviews-grid{grid-template-columns:repeat(3,1fr);grid-template-rows:none;gap:16px}.review-card,.review-card:first-child{min-height:300px;grid-column:auto;grid-row:auto;padding:29px;border:1px solid var(--grey-200,var(--b200));border-radius:var(--radius-md,24px);color:var(--ink);background:var(--grey-50,var(--b50))}.review-card:first-child blockquote{margin:0 0 28px;color:var(--ink);font-size:.96rem}.review-card:first-child .review-person{border-color:var(--grey-200,var(--b200))}.review-card:first-child .review-person span>span{color:var(--ink-soft,var(--soft))}.review-card:first-child .review-source{color:var(--blue-600,var(--b600))}.review-stars{margin-bottom:23px;color:#e4b94f;font-size:.82rem;letter-spacing:2px}.review-person{align-items:flex-end;gap:12px;padding-top:18px;border-top:1px solid var(--grey-200,var(--b200))}.review-source{margin-left:auto;color:var(--blue-600,var(--b600));font-size:.62rem;font-weight:700}@media(max-width:820px){.reviews-grid{grid-template-columns:1fr;grid-template-rows:none}.review-card,.review-card:first-child{min-height:250px;grid-column:auto;grid-row:auto;padding:27px}} .review-heading-row h2{font-size:clamp(2rem,4.4vw,3.55rem);font-weight:700;line-height:1.1;letter-spacing:-.035em}.google-proof{gap:13px;padding-bottom:6px;font-size:inherit;font-weight:inherit}.google-proof .google-g{width:43px;height:43px;box-shadow:var(--shadow-sm)}.google-proof strong{font-size:.78rem;font-weight:700}.google-proof a{font-size:.67rem;font-weight:700}.review-card blockquote{font-size:.96rem;font-weight:500;letter-spacing:-.02em;line-height:1.55}</style>