---
import SiteLayout from "../layouts/SiteLayout.astro";
const styles = `
:root{--ink:#183042;--soft:#526978;--b900:#153e60;--b800:#1d5077;--b700:#286b9d;--b600:#3d86b9;--b300:#a9d1e7;--b200:#cfe7f3;--b100:#e8f5fb;--b50:#f4fafc;--white:#fff;--beige:#f4df9f;--beige2:#fbf2d5;--shell:min(1180px,calc(100% - 48px));--shadow:0 18px 46px rgba(23,63,93,.09)}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:#fff;font:16px/1.65 "DM Sans",Arial,sans-serif}.shell{width:var(--shell);margin:auto}h1,h2,h3{font-family:"Plus Jakarta Sans",Arial,sans-serif;letter-spacing:-.04em;line-height:1.08;text-wrap:balance}h1{max-width:820px;margin:17px 0 20px;font-size:clamp(3rem,6vw,5rem);font-weight:620}h2{margin:0;font-size:clamp(2rem,4.4vw,3.55rem)}h3{margin:0}p{color:var(--soft)}.kicker{display:flex;align-items:center;gap:10px;margin-bottom:19px;color:var(--b700);font-size:.76rem;font-weight:800;letter-spacing:.14em;line-height:1;text-transform:uppercase}.kicker:before{content:"";width:26px;height:2px;background:currentColor}.hero{padding:calc(var(--nav-height,84px) + 68px) 0 78px;color:#fff;background:var(--b900)}.hero .kicker{color:var(--beige)}.hero p{max-width:650px;margin:0;color:var(--b200)}.family{padding:clamp(84px,9vw,126px) 0}.family--soft{background:var(--b50)}.heading{display:grid;grid-template-columns:1.1fr .65fr;align-items:end;gap:44px;margin-bottom:54px}.heading p{margin:0}.option{padding:52px 0 64px;border-top:1px solid var(--b200)}.option:first-of-type{padding-top:0;border-top:0}.option-label{display:flex;justify-content:space-between;gap:20px;margin-bottom:29px;color:var(--b700);font-size:.69rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.option-label span:last-child{color:var(--soft)}
/* BUILT / 01 */.priority-layout{display:grid;grid-template-columns:.86fr 1.14fr;gap:clamp(45px,8vw,104px);align-items:center}.priority-copy h3{max-width:450px;font-size:clamp(2.15rem,3.7vw,3.6rem)}.priority-copy p{max-width:420px}.priority-list{border-top:1px solid var(--b200)}.priority-item{display:grid;grid-template-columns:45px 1fr;gap:17px;padding:21px 0;border-bottom:1px solid var(--b200)}.priority-item b{display:grid;width:35px;height:35px;place-items:center;border-radius:50%;color:var(--b800);background:var(--beige);font-size:.63rem}.priority-item strong{font-size:.95rem}.priority-item p{margin:4px 0 0;font-size:.76rem}
/* BUILT / 02 */.brief{display:grid;grid-template-columns:1.2fr .8fr;overflow:hidden;border:1px solid var(--b200);border-radius:25px;background:#fff}.brief-main{min-height:350px;padding:clamp(32px,5vw,54px);color:#fff;background:var(--b900)}.brief-main .kicker{color:var(--beige)}.brief-main h3{max-width:490px;font-size:clamp(2.1rem,3.8vw,3.7rem)}.brief-main p{max-width:500px;color:var(--b200)}.brief-aside{display:grid;align-content:center;gap:0;padding:28px 34px;background:var(--beige2)}.brief-aside div{padding:19px 0;border-bottom:1px solid rgba(24,48,66,.13)}.brief-aside div:last-child{border:0}.brief-aside span{display:block;margin-bottom:5px;color:var(--b700);font-size:.63rem;font-weight:800;letter-spacing:.1em}.brief-aside strong{font-size:.91rem}
/* BUILT / 03 */.split-notes{display:grid;grid-template-columns:repeat(2,1fr);gap:0;border-top:1px solid var(--b200);border-bottom:1px solid var(--b200)}.split-notes article{padding:31px 34px}.split-notes article+article{border-left:1px solid var(--b200)}.split-notes article:nth-child(2){background:var(--b50)}.split-notes article:nth-child(3){background:var(--beige2)}.split-notes span{display:block;margin-bottom:34px;color:var(--b600);font-size:.66rem;font-weight:800;letter-spacing:.1em}.split-notes h3{font-size:1.15rem}.split-notes p{margin:8px 0 0;font-size:.76rem}
/* HOW / 01 */.booking-band{display:grid;grid-template-columns:.8fr 1.2fr;overflow:hidden;border:1px solid var(--b200);border-radius:24px}.booking-band__intro{padding:clamp(32px,5vw,52px);background:var(--b50)}.booking-band__intro h3{font-size:clamp(2rem,3.5vw,3.3rem)}.booking-band__intro p{max-width:340px}.booking-row{display:grid;grid-template-columns:44px 1fr;gap:17px;padding:26px 32px;border-bottom:1px solid var(--b200)}.booking-row:last-child{border:0}.booking-row b{color:var(--b700);font-size:.7rem}.booking-row strong{font-size:.96rem}.booking-row p{margin:4px 0 0;font-size:.74rem}
/* HOW / 02 */.process-columns{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.process-columns article{position:relative;min-height:250px;padding:29px;border:1px solid var(--b200);border-radius:20px;background:#fff}.process-columns article:nth-child(2){margin-top:34px;background:var(--b50)}.process-columns article:nth-child(3){background:var(--beige2)}.process-columns span{display:block;margin-bottom:51px;color:var(--b700);font-size:.68rem;font-weight:800;letter-spacing:.1em}.process-columns h3{font-size:1.08rem}.process-columns p{margin:8px 0 0;font-size:.75rem}
/* HOW / 03 */.steps-editorial{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(45px,8vw,100px);align-items:start}.steps-editorial__intro{position:sticky;top:110px}.steps-editorial__intro h3{font-size:clamp(2.1rem,3.8vw,3.65rem)}.editorial-step{display:grid;grid-template-columns:70px 1fr;gap:23px;padding:27px 0;border-top:1px solid var(--b200)}.editorial-step:last-child{border-bottom:1px solid var(--b200)}.editorial-step b{color:var(--b700);font-size:.72rem;letter-spacing:.08em}.editorial-step h3{font-size:1.14rem}.editorial-step p{max-width:490px;margin:7px 0 0;font-size:.77rem}
/* GUARANTEE / 01 */.support-panel{display:grid;grid-template-columns:1.05fr .95fr;overflow:hidden;border-radius:26px;color:#fff;background:var(--b900)}.support-panel__main{min-height:350px;padding:clamp(34px,5vw,55px)}.support-panel .kicker{color:var(--beige)}.support-panel h3{max-width:530px;font-size:clamp(2.1rem,3.8vw,3.7rem)}.support-panel p{max-width:500px;color:var(--b200)}.support-facts{display:grid;align-content:center;padding:26px 38px;background:rgba(255,255,255,.06)}.support-facts div{padding:19px 0;border-bottom:1px solid rgba(255,255,255,.16)}.support-facts div:last-child{border:0}.support-facts strong{display:block;color:var(--beige);font-size:.95rem}.support-facts span{display:block;margin-top:3px;color:var(--b200);font-size:.74rem}
/* GUARANTEE / 02 */.guarantee-rows{border-top:1px solid var(--b200)}.guarantee-row{display:grid;grid-template-columns:180px 1fr auto;align-items:center;gap:30px;padding:25px 24px;border-bottom:1px solid var(--b200);background:rgba(255,255,255,.6)}.guarantee-row:nth-child(2){background:var(--beige2)}.guarantee-row b{color:var(--b800);font-size:.8rem}.guarantee-row strong{display:block;font-size:.98rem}.guarantee-row p{margin:4px 0 0;font-size:.75rem}.guarantee-row span{padding:6px 8px;border-radius:7px;color:var(--b800);background:var(--b100);font-size:.62rem;font-weight:800}
/* GUARANTEE / 03 */.guarantee-editorial{display:grid;grid-template-columns:.75fr 1.25fr;gap:clamp(46px,8vw,104px);align-items:start}.guarantee-editorial__intro h3{font-size:clamp(2.1rem,3.8vw,3.65rem)}.guarantee-editorial__intro p{max-width:360px}.guarantee-list{border-top:2px solid var(--ink)}.guarantee-list div{display:grid;grid-template-columns:122px 1fr;gap:22px;padding:23px 0;border-bottom:1px solid var(--b200)}.guarantee-list span{color:var(--b700);font-size:.67rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.guarantee-list strong{font-size:.94rem}.guarantee-list p{margin:5px 0 0;font-size:.75rem}
@media(max-width:820px){.heading,.priority-layout,.brief,.booking-band,.steps-editorial,.support-panel,.guarantee-editorial{grid-template-columns:1fr}.steps-editorial__intro{position:static}.process-columns{gap:12px}.process-columns article:nth-child(2){margin-top:0}.brief-main{min-height:280px}.support-panel__main{min-height:290px}}@media(max-width:620px){:root{--shell:calc(100% - 30px)}.family{padding-block:78px}.heading{gap:10px}.option{padding:43px 0 54px}.split-notes,.process-columns{grid-template-columns:1fr}.split-notes article+article{border-top:1px solid var(--b200);border-left:0}.process-columns article{min-height:0}.booking-band__intro{padding:28px 22px}.booking-row{padding:22px}.guarantee-row{grid-template-columns:1fr;gap:8px;padding:22px}.guarantee-row span{justify-self:start}.guarantee-list div{grid-template-columns:1fr;gap:7px}.brief-aside,.support-facts{padding:22px}.split-notes article{padding:26px}}
`;
---
<SiteLayout title="Suburb section alternatives | Maid At Home" description="Nine restrained alternatives for suburb-page sections." styles={styles} robots="noindex,nofollow" currentPath=""><main>
<section class="hero"><div class="shell"><div class="kicker">Design study</div><h1>Layouts that stay within the page’s existing visual language.</h1><p>Three options for each section, using only the site’s typography, colours, borders, spacing and restrained surface treatments. No animation or abstract visual devices.</p></div></section>
<section class="family"><div class="shell"><header class="heading"><div><div class="kicker">Built around your home</div><h2>Three quieter ways to present personalisation.</h2></div><p>White background, as on the current page.</p></header>
<div class="option"><div class="option-label"><span>Option 01 · Priority list</span><span>Copy + guided list</span></div><div class="priority-layout"><div class="priority-copy"><h3>Start with what would help most at home.</h3><p>A focused introduction beside a practical list of the things customers can set before the visit.</p></div><div class="priority-list"><div class="priority-item"><b>01</b><div><strong>Rooms that matter most</strong><p>Direct attention to the spaces that need the strongest reset.</p></div></div><div class="priority-item"><b>02</b><div><strong>Details worth extra care</strong><p>Share the surfaces or tasks that make the biggest difference.</p></div></div><div class="priority-item"><b>03</b><div><strong>A schedule that suits the home</strong><p>Choose a one-off visit or a practical recurring rhythm.</p></div></div></div></div></div>
<div class="option"><div class="option-label"><span>Option 02 · Service brief</span><span>Feature panel + summary</span></div><div class="brief"><div class="brief-main"><div class="kicker">Your cleaning brief</div><h3>Tell us what a good clean looks like for your home.</h3><p>A stronger lead statement paired with a compact summary of the decisions customers make before booking.</p></div><div class="brief-aside"><div><span>FOCUS</span><strong>Rooms and surfaces that need attention</strong></div><div><span>DETAIL</span><strong>Practical notes for the cleaner or team</strong></div><div><span>RHYTHM</span><strong>One-off or recurring support around your week</strong></div></div></div></div>
<div class="option"><div class="option-label"><span>Option 03 · Notes grid</span><span>Four concise prompts</span></div><div class="split-notes"><article><span>01 / ROOMS</span><h3>Choose where to focus.</h3><p>Prioritise the rooms that would benefit most from a reset.</p></article><article><span>02 / DETAILS</span><h3>Share useful context.</h3><p>Flag the tasks, surfaces or access details that matter.</p></article><article><span>03 / SCOPE</span><h3>Keep expectations clear.</h3><p>The visit stays realistic for the selected service and time.</p></article><article><span>04 / ROUTINE</span><h3>Adjust as you go.</h3><p>Refine future visits after seeing what works best.</p></article></div></div>
</div></section>
<section class="family"><div class="shell"><header class="heading"><div><div class="kicker">How booking works</div><h2>Three clear ways to frame the booking process.</h2></div><p>White background, as on the current page.</p></header>
<div class="option"><div class="option-label"><span>Option 01 · Booking band</span><span>Intro + structured steps</span></div><div class="booking-band"><div class="booking-band__intro"><div class="kicker">A clear start</div><h3>Everything you need, in the right order.</h3><p>The process remains easy to scan, with a short explanation beside the sequence.</p></div><div><div class="booking-row"><b>01</b><div><strong>Choose the service</strong><p>Select the clean, home size and optional extras that fit the visit.</p></div></div><div class="booking-row"><b>02</b><div><strong>Request a preferred time</strong><p>Share the date, access details and any practical booking notes.</p></div></div><div class="booking-row"><b>03</b><div><strong>Receive confirmation</strong><p>We confirm cleaner availability and send the final booking details.</p></div></div></div></div></div>
<div class="option"><div class="option-label"><span>Option 02 · Offset steps</span><span>Compact / visual rhythm</span></div><div class="process-columns"><article><span>01 / CHOOSE</span><h3>Build the clean.</h3><p>Choose the service and details that match the home’s condition.</p></article><article><span>02 / REQUEST</span><h3>Set a preferred time.</h3><p>Share the information we need to check current availability.</p></article><article><span>03 / CONFIRM</span><h3>We organise the visit.</h3><p>Receive a confirmation before your cleaner arrives.</p></article></div></div>
<div class="option"><div class="option-label"><span>Option 03 · Editorial steps</span><span>Text-led / spacious</span></div><div class="steps-editorial"><div class="steps-editorial__intro"><div class="kicker">How it works</div><h3>A simple path from booking to clean.</h3><p>Minimal surface treatment, with the sequence carrying the visual weight.</p></div><div><div class="editorial-step"><b>01</b><div><h3>Choose the right starting point.</h3><p>Select a Standard, Deep, Move In, End of Lease or Hourly clean based on the home’s current condition.</p></div></div><div class="editorial-step"><b>02</b><div><h3>Send your preferred booking details.</h3><p>Review the estimate and include the date, access details and any useful notes for the cleaner.</p></div></div><div class="editorial-step"><b>03</b><div><h3>We confirm current availability.</h3><p>Once a suitable cleaner or team is organised, we send the confirmation and next steps.</p></div></div></div></div></div>
</div></section>
<section class="family family--soft"><div class="shell"><header class="heading"><div><div class="kicker">Our cleaning guarantee</div><h2>Three calmer, clearer directions for after-clean support.</h2></div><p>Soft grey-blue background, as on the current page.</p></header>
<div class="option"><div class="option-label"><span>Option 01 · Support panel</span><span>Reassurance + key facts</span></div><div class="support-panel"><div class="support-panel__main"><div class="kicker">Support that continues after the clean</div><h3>Contact us while the details are still clear.</h3><p>If an agreed task was missed, send us the relevant details so we can assess the concern and arrange the appropriate next step where applicable.</p></div><div class="support-facts"><div><strong>48-hour window</strong><span>Standard, Deep, Move In and Hourly services.</span></div><div><strong>7-day window</strong><span>Eligible End of Lease concerns with agent feedback.</span></div><div><strong>Clear communication</strong><span>Photos or notes help us understand the request.</span></div></div></div></div>
<div class="option"><div class="option-label"><span>Option 02 · Response rows</span><span>Policy information / easy scan</span></div><div class="guarantee-rows"><div class="guarantee-row"><b>48 hours</b><div><strong>Everyday cleaning support</strong><p>For missed agreed tasks on Standard, Deep, Move In or Hourly services.</p></div><span>CONTACT US</span></div><div class="guarantee-row"><b>7 days</b><div><strong>End of Lease support</strong><p>For eligible concerns with agent feedback and supporting photos.</p></div><span>SHARE DETAILS</span></div><div class="guarantee-row"><b>Ongoing</b><div><strong>Clear follow-through</strong><p>We remain available when a booking detail or completed task needs clarification.</p></div><span>WE ASSESS</span></div></div></div>
<div class="option"><div class="option-label"><span>Option 03 · Guarantee guide</span><span>Editorial / service-led</span></div><div class="guarantee-editorial"><div class="guarantee-editorial__intro"><div class="kicker">Our approach</div><h3>Clear windows. Practical next steps.</h3><p>A text-led version that lets the policy read more like helpful service guidance.</p></div><div class="guarantee-list"><div><span>01 / CONTACT</span><section><strong>Let us know as soon as possible.</strong><p>Include the booking details, photos or a short explanation of the agreed task that needs review.</p></section></div><div><span>02 / ASSESS</span><section><strong>We review the concern in context.</strong><p>We consider the agreed scope, information provided and what remedy may be appropriate.</p></section></div><div><span>03 / RESOLVE</span><section><strong>We arrange the next step where applicable.</strong><p>Approved return visits require reasonable access to the property.</p></section></div></div></div></div>
</div></section>
</main></SiteLayout>