---
import SiteLayout from "../layouts/SiteLayout.astro";

const reviews = [
  { name: "Erin", detail: "Melbourne - Home cleaning", quote: "Amazing experience with Maid at Home - super professional, great communication, and my place looks spotless. Highly recommend if you want reliable service with zero hassle!" },
  { name: "Anna", detail: "Melbourne - Regular clean", quote: "Great team. We have been using Maid at Home for over 2.5 years. They are fabulous, our house is always spotless after they have been here. I would highly recommend them." },
  { name: "Elly", detail: "Melbourne - Deep clean", quote: "We were so happy with our recent deep clean! Stefania and her partner did a perfect job getting our house ready for real estate photos. They went above and beyond." },
];

const styles = `
:root{--ink:#183042;--soft:#526978;--b900:#153e60;--b800:#1d5077;--b700:#286b9d;--b600:#3d86b9;--b300:#a9d1e7;--b200:#cfe7f3;--b50:#f4fafc;--white:#fff;--beige:#f4df9f;--beige2:#fbf2d5;--shell:min(1180px,calc(100% - 48px));--shadow:0 18px 46px rgba(23,63,93,.09)}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:#fff;font:16px/1.65 "DM Sans",Arial,sans-serif}.shell{width:var(--shell);margin:auto}h1,h2,h3{font-family:"Plus Jakarta Sans",Arial,sans-serif;letter-spacing:-.04em;line-height:1.08;text-wrap:balance}h1{max-width:800px;margin:17px 0 20px;font-size:clamp(3rem,6vw,5rem);font-weight:620}h2{margin:0;font-size:clamp(2rem,4.4vw,3.55rem)}h3{margin:0}p{color:var(--soft)}.kicker{display:flex;align-items:center;gap:10px;margin-bottom:19px;color:var(--b700);font-size:.76rem;font-weight:800;letter-spacing:.14em;line-height:1;text-transform:uppercase}.kicker:before{content:"";width:26px;height:2px;background:currentColor}.hero{padding:calc(var(--nav-height,84px) + 68px) 0 78px;color:#fff;background:var(--b900)}.hero .kicker{color:var(--beige)}.hero p{max-width:650px;margin:0;color:var(--b200)}.study{padding:clamp(84px,9vw,126px) 0}.study--soft{background:var(--b50)}.study-head{display:grid;grid-template-columns:1.1fr .65fr;align-items:end;gap:44px;margin-bottom:52px}.study-head p{margin:0}.option{padding:54px 0 68px;border-top:1px solid var(--b200)}.option:first-of-type{padding-top:0;border-top:0}.option-label{display:flex;justify-content:space-between;gap:18px;margin-bottom:29px;color:var(--b700);font-size:.69rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.option-label span:last-child{color:var(--soft)}.google{display:inline-flex;align-items:center;gap:11px;color:var(--b800);font-size:.76rem;font-weight:700}.google img{width:37px;height:37px;padding:7px;border:1px solid var(--b200);border-radius:50%;background:#fff}.stars{margin-bottom:20px;color:#e4b94f;font-size:.8rem;letter-spacing:2px}.person{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:auto;padding-top:18px;border-top:1px solid currentColor;font-size:.7rem}.person strong{display:block}.person small{display:block;margin-top:3px;font-size:.65rem}.source{font-size:.61rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.quote{margin:0;color:inherit;font:500 .96rem/1.55 "Plus Jakarta Sans",Arial,sans-serif;letter-spacing:-.02em}
/* 01: feature review + supporting notes */.feature-reviews{display:grid;grid-template-columns:1.12fr .88fr;gap:15px}.feature-main{display:flex;min-height:405px;padding:clamp(32px,5vw,52px);border-radius:26px;color:#fff;flex-direction:column;background:var(--b900)}.feature-main .quote{max-width:590px;margin:auto 0;font-size:clamp(1.25rem,2.35vw,1.85rem);line-height:1.45}.feature-main .person{border-color:rgba(255,255,255,.2)}.feature-main small{color:var(--b200)}.feature-main .source{color:var(--beige)}.feature-side{display:grid;gap:15px}.feature-note{display:flex;min-height:195px;padding:27px;border:1px solid var(--b200);border-radius:20px;flex-direction:column;background:var(--b50)}.feature-note:nth-child(2){background:var(--beige2)}.feature-note .person{border-color:var(--b200)}
/* 02: full-width review ledger */.review-ledger{border-top:2px solid var(--ink)}.ledger-row{display:grid;grid-template-columns:125px minmax(0,1fr) 120px;gap:27px;padding:28px 0;border-bottom:1px solid var(--b200)}.ledger-row:nth-child(2){padding-inline:25px;background:var(--b50)}.ledger-id strong{display:block;font-size:.9rem}.ledger-id span{display:block;margin-top:4px;color:var(--soft);font-size:.67rem}.ledger-row .stars{margin:1px 0 8px}.ledger-row .quote{max-width:690px}.ledger-meta{align-self:end;text-align:right}.ledger-meta .google{font-size:.65rem}.ledger-meta .google img{width:31px;height:31px;padding:6px}.ledger-meta .source{display:block;margin-top:12px;color:var(--b700)}
/* 03: editorial proof wall */.proof-wall{display:grid;grid-template-columns:.68fr 1.32fr;gap:clamp(40px,7vw,94px);align-items:start}.proof-intro{position:sticky;top:110px}.proof-intro h2{margin-bottom:22px}.proof-intro>p{max-width:340px;margin-bottom:28px}.proof-intro .google{padding-top:18px;border-top:1px solid var(--b200)}.proof-list{border-top:1px solid var(--b200)}.proof-item{position:relative;padding:31px 0 30px 72px;border-bottom:1px solid var(--b200)}.proof-item:before{content:"“";position:absolute;top:22px;left:2px;color:var(--beige);font:800 4.5rem/.8 Georgia,serif}.proof-item:nth-child(2){padding-left:0}.proof-item:nth-child(2):before{display:none}.proof-item:nth-child(2) .quote{max-width:740px;color:var(--b800);font-size:clamp(1.18rem,2.15vw,1.65rem);line-height:1.45}.proof-item .person{justify-content:flex-start;gap:14px;border:0}.proof-item .source{margin-left:auto;color:var(--b700)}
@media(max-width:820px){.study-head,.feature-reviews,.proof-wall{grid-template-columns:1fr}.proof-intro{position:static}.feature-main{min-height:320px}.ledger-row{grid-template-columns:105px 1fr}.ledger-meta{grid-column:2;text-align:left}.ledger-meta .google{display:none}}@media(max-width:620px){:root{--shell:calc(100% - 30px)}.study{padding-block:78px}.study-head{gap:10px}.option{padding:43px 0 54px}.option-label{align-items:flex-start;flex-direction:column}.feature-main,.feature-note{padding:26px}.feature-note{min-height:0}.ledger-row{grid-template-columns:1fr;gap:12px;padding:24px 0}.ledger-row:nth-child(2){padding-inline:0;background:transparent}.ledger-meta{grid-column:auto}.proof-item{padding-left:48px}.proof-item:before{font-size:3.6rem}.proof-item:nth-child(2){padding-left:0}}
`;
---
<SiteLayout title="Testimonials alternatives | Maid At Home" description="Three testimonials layouts using current customer reviews." styles={styles} robots="noindex,nofollow" currentPath=""><main>
<section class="hero"><div class="shell"><div class="kicker">Testimonials study</div><h1>Three alternatives for customer stories.</h1><p>Each design uses the current testimonials unchanged and retains the Google logo and existing visual system. The live testimonials section is not modified.</p></div></section>
<section class="study"><div class="shell"><header class="study-head"><div><div class="kicker">Customer stories</div><h2>Three layouts, one trusted set of reviews.</h2></div><p>All variants keep the page’s existing white and soft-grey surfaces, blue hierarchy, beige accent and restrained borders.</p></header>
<div class="option"><div class="option-label"><span>Option 01 · Feature review</span><span>One lead story + two supporting reviews</span></div><div class="feature-reviews">{reviews.map((review, index) => <article class={index === 0 ? "feature-main" : "feature-note"}><div class="stars" aria-label="Five out of five stars">★★★★★</div><blockquote class="quote">“{review.quote}”</blockquote><div class="person"><span><strong>{review.name}</strong><small>{review.detail}</small></span><a class="source" href="https://share.google/qCmogE26ZAerwedX6" target="_blank" rel="noopener noreferrer">Verify review on Google</a></div></article>)}</div></div>
<div class="option"><div class="option-label"><span>Option 02 · Review ledger</span><span>Editorial rows / direct comparison</span></div><div class="review-ledger">{reviews.map((review) => <article class="ledger-row"><div class="ledger-id"><strong>{review.name}</strong><span>{review.detail}</span></div><div><div class="stars" aria-label="Five out of five stars">★★★★★</div><blockquote class="quote">“{review.quote}”</blockquote></div><div class="ledger-meta"><span class="google"><img src="/assets/google-icon-logo-svgrepo-com.svg" alt="Google" loading="lazy" />Google review</span><a class="source" href="https://share.google/qCmogE26ZAerwedX6" target="_blank" rel="noopener noreferrer">Verify review on Google</a></div></article>)}</div></div>
<div class="option"><div class="option-label"><span>Option 03 · Proof wall</span><span>Editorial intro + review stream</span></div><div class="proof-wall"><aside class="proof-intro"><div class="kicker">Feedback on Google</div><h2>Why Melbourne families love coming home.</h2><p>Customer feedback sits beside a simple Google proof point, leaving the words themselves to do the work.</p><a class="google" href="https://share.google/qCmogE26ZAerwedX6" target="_blank" rel="noopener noreferrer"><img src="/assets/google-icon-logo-svgrepo-com.svg" alt="Google" loading="lazy" />View our Google profile</a></aside><div class="proof-list">{reviews.map((review) => <article class="proof-item"><div class="stars" aria-label="Five out of five stars">★★★★★</div><blockquote class="quote">“{review.quote}”</blockquote><div class="person"><span><strong>{review.name}</strong><small>{review.detail}</small></span><a class="source" href="https://share.google/qCmogE26ZAerwedX6" target="_blank" rel="noopener noreferrer">Verify review on Google</a></div></article>)}</div></div></div>
</div></section>
</main></SiteLayout>