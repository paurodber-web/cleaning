---
import SiteLayout from '../../layouts/SiteLayout.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';

const title = 'Regular Clean Melbourne | Maid At Home';
const description = 'Set up weekly, fortnightly or flexible recurring house cleaning in Melbourne. Choose Standard or Deep cleaning, compare savings and book online.';

const styles = `
:root{--regular-ink:#183042;--regular-soft:#526978;--regular-blue-900:#153e60;--regular-blue-800:#1d5077;--regular-blue-700:#286b9d;--regular-blue-300:#a9d1e7;--regular-blue-200:#cfe7f3;--regular-blue-100:#e8f5fb;--regular-blue-50:#f4fafc;--regular-beige:#f4df9f;--regular-beige-light:#fbf2d5;--regular-white:#fff;--regular-green:#2e755d;--regular-shell:min(1180px,calc(100% - 48px));--regular-shadow:0 24px 70px rgba(23,63,93,.13);--regular-ease:cubic-bezier(.22,1,.36,1);--nav-height:84px}
*,*:before,*:after{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:105px}body{margin:0;min-width:320px;overflow-x:clip;color:var(--regular-ink);background:var(--regular-white);font:16px/1.6 "DM Sans",Arial,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button{font:inherit}.skip-link{position:fixed;z-index:1000;top:12px;left:12px;padding:11px 16px;color:#fff;background:var(--regular-blue-900);border-radius:8px;transform:translateY(-160%);transition:transform .2s}.skip-link:focus{transform:none}.site-header .nav{width:var(--regular-shell);margin-inline:auto}.regular-main img{display:block;width:100%;height:100%;object-fit:cover}.regular-main h1,.regular-main h2,.regular-main h3{font-family:"Plus Jakarta Sans",Arial,sans-serif;letter-spacing:-.045em;text-wrap:balance}.regular-main p{color:var(--regular-soft);text-wrap:pretty}.regular-shell{width:var(--regular-shell);margin-inline:auto}.regular-section{position:relative;padding-block:clamp(84px,9vw,132px)}.regular-section--soft{background:var(--regular-blue-50)}.regular-kicker{display:flex;align-items:center;gap:10px;margin-bottom:20px;color:var(--regular-blue-700);font-size:.72rem;font-weight:800;letter-spacing:.14em;line-height:1;text-transform:uppercase}.regular-kicker:before{content:"";width:26px;height:2px;background:currentColor}.regular-heading{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(270px,.62fr);align-items:end;gap:48px;margin-bottom:clamp(42px,6vw,68px)}.regular-heading h2{max-width:760px;margin:0;font-size:clamp(2.15rem,4.6vw,3.75rem);font-weight:650;line-height:1.04}.regular-heading>p{max-width:470px;margin:0 0 5px}.regular-reveal{opacity:0;transform:translateY(22px);transition:opacity .75s var(--regular-ease),transform .75s var(--regular-ease)}.regular-reveal.is-visible{opacity:1;transform:none}
.regular-button{display:inline-flex;min-height:56px;align-items:center;justify-content:space-between;gap:22px;padding:7px 7px 7px 22px;border:1px solid transparent;border-radius:999px;font-size:.91rem;font-weight:750;line-height:1;transition:transform .3s var(--regular-ease),background .3s,box-shadow .3s}.regular-button:hover{transform:translateY(-2px)}.regular-button:active{transform:translateY(0) scale(.985)}.regular-button:focus-visible{outline:3px solid var(--regular-beige);outline-offset:4px}.regular-button__icon{display:grid;width:42px;height:42px;flex:0 0 42px;place-items:center;border-radius:50%;transition:transform .35s var(--regular-ease)}.regular-button:hover .regular-button__icon{transform:rotate(-7deg) translateX(2px)}.regular-button__icon svg{width:17px;height:17px}.regular-button--blue{color:#fff;background:var(--regular-blue-700)}.regular-button--blue:hover{background:var(--regular-blue-800)}.regular-button--blue .regular-button__icon{color:var(--regular-blue-900);background:var(--regular-beige)}.regular-button--beige{color:var(--regular-ink);background:var(--regular-beige);box-shadow:0 12px 28px rgba(26,54,72,.15)}.regular-button--beige .regular-button__icon{color:#fff;background:var(--regular-blue-800)}.regular-text-link{display:inline-flex;align-items:center;gap:9px;color:var(--regular-blue-700);font-size:.82rem;font-weight:800}.regular-text-link svg{width:16px;transition:transform .25s}.regular-text-link:hover svg{transform:translateX(4px)}
.regular-hero{position:relative;padding:calc(var(--nav-height) + 30px) 0 76px;overflow:hidden;background:var(--regular-blue-50)}.regular-hero:before{content:"";position:absolute;top:110px;right:-175px;width:380px;height:380px;border:60px solid rgba(169,209,231,.22);border-radius:50%}.regular-breadcrumb{display:flex;align-items:center;gap:10px;margin-bottom:42px;color:var(--regular-soft);font-size:.71rem;font-weight:650}.regular-breadcrumb a{color:var(--regular-blue-700)}.regular-breadcrumb svg{width:13px;color:var(--regular-blue-300)}.regular-hero__grid{position:relative;display:grid;grid-template-columns:minmax(0,1.06fr) minmax(400px,.86fr);align-items:center;gap:clamp(48px,7vw,96px)}.regular-hero__copy{max-width:710px}.regular-hero__eyebrow{display:inline-flex;margin-bottom:19px;color:var(--regular-blue-700);font-size:.72rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.regular-hero h1{max-width:760px;margin:0 0 22px;font-size:clamp(3rem,5.2vw,4.7rem);font-weight:600;line-height:.98;letter-spacing:-.06em}.regular-hero h1 em{color:var(--regular-blue-700);font-style:normal}.regular-hero__lead{max-width:610px;margin:0 0 23px;font-size:1rem}.regular-hero__note{display:flex;align-items:flex-start;gap:12px;max-width:610px;margin-bottom:26px;padding:13px 16px;border-left:3px solid var(--regular-beige);background:rgba(255,255,255,.58)}.regular-hero__note strong{display:block;margin-bottom:2px;font-size:.78rem}.regular-hero__note span{display:block;color:var(--regular-soft);font-size:.73rem}.regular-hero__actions{display:flex;flex-wrap:wrap;gap:12px}.regular-hero__visual{position:relative;height:430px}.regular-hero__visual>img{border-radius:26px 130px 26px 26px;box-shadow:var(--regular-shadow);object-position:center}.regular-hero__badge{position:absolute;right:-18px;bottom:22px;width:180px;padding:18px;border-radius:18px;background:var(--regular-beige);box-shadow:0 16px 38px rgba(24,48,66,.16)}.regular-hero__badge strong{display:block;font:650 1.55rem/1 "P