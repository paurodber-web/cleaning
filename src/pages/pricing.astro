---
import SiteLayout from "../layouts/SiteLayout.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import {
  calculatorExtraConfig,
  calculatorExtras,
  hourlyExtrasNotice,
} from "../data/calculator-extras.mjs";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const withBase = (markup: string) =>
  markup.replace(/(href|src)=([\"\'])\/(?!\/)/g, "$1=$2" + base);
const withBaseStyles = (css: string) =>
  css.replace(/url\((['"]?)\/(?!\/)/g, "url($1" + base);
const title = `House Cleaning Prices Melbourne | Maid At Home`;
const description = `See Melbourne house cleaning prices, hourly and flat-rate options, recurring discounts, optional extras and an instant Maid At Home estimate.`;
const capitaliseExtraKey = (value: string) =>
  value.charAt(0).toUpperCase() + value.slice(1);

const calculatorExtraConfigJson = JSON.stringify(calculatorExtraConfig);
const hourlyExtrasNoticeJson = JSON.stringify(hourlyExtrasNotice);
const calculatorCheckIcon = `<span class="extra-card__check"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m3 8 3 3 7-7"></path></svg></span>`;
const calculatorExtrasMarkup = calculatorExtras
  .map((extra) => {
    const inputId = "extra" + capitaliseExtraKey(extra.key);
    const quantityClass = extra.quantity ? " has-qty" : "";
    const quantityMarkup = extra.quantity
      ? `<div class="extra-qty"><span>${extra.quantity.label}</span><span class="stepper" data-stepper="${extra.key}"><button type="button" data-action="minus" aria-label="Remove one ${extra.quantity.label.toLowerCase().replace(/s$/, "")}">&#8722;</button><output>${extra.quantity.min}</output><button type="button" data-action="plus" aria-label="Add one ${extra.quantity.label.toLowerCase().replace(/s$/, "")}">+</button></span></div>`
      : "";
    return `<div class="extra-option${quantityClass}" data-extra="${extra.key}"><input type="checkbox" id="${inputId}" value="${extra.key}"><label class="extra-card" for="${inputId}">${calculatorCheckIcon}<span class="extra-card__text"><strong>${extra.name}</strong><small>${extra.priceLabel}</small></span></label>${quantityMarkup}</div>`;
  })
  .join("");
const calculatorExtrasFieldset = `<fieldset class="calc-block"><legend class="calc-legend"><span>4. Add any extras</span><small>Choose as many as you need</small></legend><div class="extras-grid" id="extrasGrid">${calculatorExtrasMarkup}</div></fieldset>`;

const pricingExtras = [
  [
    "Inside Oven",
    "A detailed clean of the accessible oven interior, including racks, trays and built-up cooking residue, so the appliance feels fresh and ready for everyday use.",
  ],
  [
    "Inside Fridge",
    "We wipe accessible shelves, drawers, door compartments and interior surfaces after the fridge has been emptied, leaving a clean space for your groceries.",
  ],
  [
    "Interior Windows",
    "A careful clean of accessible internal glass, frames and sills to lift everyday fingerprints, dust and marks while improving the natural light in each room.",
  ],
  [
    "Dishes",
    "We wash, dry and put away the dishes left in the sink or on the bench, helping return the kitchen to a calm, usable state after your clean.",
  ],
  [
    "Clean Balcony",
    "We sweep and wipe accessible balcony floors, rails and surfaces to remove dust, leaves and everyday outdoor buildup, leaving the area neat and inviting.",
  ],
  [
    "Change Bed Linen",
    "We strip and remake accessible beds using the fresh linen you provide, so each room is reset with a crisp, comfortable finish after the service.",
  ],
  [
    "Clean Walls",
    "We spot-clean accessible wall marks, scuffs and fingerprints where suitable, focusing on visible areas that benefit most from a brighter, more cared-for finish.",
  ],
  [
    "Wet Wipe Window Blinds",
    "We carefully wet-wipe accessible blind slats one at a time to reduce settled dust and surface grime, helping the window area look cleaner and feel fresher.",
  ],
  [
    "Inside All Other Cabinets",
    "We wipe the empty, accessible interiors of other cabinets, drawers and storage areas, removing dust and loose debris so they are ready to organise again.",
  ],
  [
    "Inside Kitchen Cabinets",
    "We wipe the empty, accessible interiors of kitchen cupboards and drawers, paying attention to shelves and corners so your food-storage spaces feel clean and ready to use.",
  ],
];
const pricingExtraCardsMarkup =
  pricingExtras
    .map(
      ([name, description]) =>
        `<article class="not-card pricing-not-card reveal"><div class="not-top"><small>Optional extra</small></div><h3>${name}</h3><p>${description}</p></article>`,
    )
    .join("") +
  `<article class="not-card pricing-not-card carpet-highlight reveal"><div class="not-top"><small>Featured extra</small></div><h3>Carpet Clean</h3><p>Our carpet steam-cleaning extra gives carpeted rooms a more thorough refresh than routine vacuuming. We treat the accessible carpet area to lift embedded dirt, everyday odours and surface marks, then leave you with practical drying guidance so the space can be used again once the fibres are fully dry.</p><ul class="carpet-details"><li><strong>1–3 hrs</strong><span>typical treatment time depending on access</span></li><li><strong>2-room minimum</strong><span>per booking</span></li><li><strong>6–12 hours</strong><span>typical drying time</span></li></ul></article>`;
const styles = withBaseStyles(
