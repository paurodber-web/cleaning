,box-shadow .35s var(--ease)}.site-header.is-scrolled{height:var(--nav-height);background:rgba(255,255,255,.96);box-shadow:0 8px 30px rgba(27,63,88,.08);backdrop-filter:blur(14px)}.nav{display:flex;height:100%;align-items:center;justify-content:space-between;gap:28px}.brand{position:relative;z-index:102;display:inline-flex;align-items:center;gap:10px;font-family:"Plus Jakarta Sans",Arial,sans-serif;font-size:1.06rem;font-weight:800;letter-spacing:-.035em}.brand__mark{display:grid;width:36px;height:36px;place-items:center;border-radius:11px 11px 16px 11px;color:var(--blue-800);background:var(--beige);box-shadow:0 7px 17px rgba(24,48,66,.13);transform:rotate(-4deg)}.brand__mark svg{display:block;width:21px;height:21px;margin:auto;transform:rotate(4deg)}.desktop-nav{display:flex;align-items:center;gap:clamp(18px,2.1vw,32px);margin-left:auto}.desktop-nav a:not(.nav-cta){position:relative;padding-block:8px;font-size:.83rem;font-weight:600}.desktop-nav a:not(.nav-cta)::after{content:"";position:absolute;right:0;bottom:2px;left:0;height:1px;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform .35s var(--ease)}.desktop-nav a:not(.nav-cta):hover::after,.desktop-nav a[aria-current="page"]::after{transform:scaleX(1);transform-origin:left}.nav-cta{display:inline-flex;min-height:43px;align-items:center;gap:12px;padding:5px 6px 5px 17px;border-radius:100px;color:var(--ink);background:var(--beige);font-size:.8rem;font-weight:700}.nav-cta span{display:grid;width:31px;height:31px;place-items:center;border-radius:50%;color:var(--white);background:var(--blue-800)}.nav-cta svg{width:13px;height:13px}.menu-toggle{position:relative;z-index:102;display:none;width:48px;height:48px;border:1px solid var(--grey-200);border-radius:50%;cursor:pointer;background:var(--blue-50)}.menu-toggle span{position:absolute;left:14px;width:19px;height:1.5px;border-radius:4px;background:currentColor;transform-origin:center;transition:transform .52s var(--ease),top .52s var(--ease),width .35s var(--ease),opacity .3s}.menu-toggle span:nth-child(1){top:17px}.menu-toggle span:nth-child(2){top:23px;width:14px}.menu-toggle span:nth-child(3){top:29px}.menu-toggle[aria-expanded="true"] span:nth-child(1){top:23px;transform:rotate(45deg)}.menu-toggle[aria-expanded="true"] span:nth-child(2){opacity:0;transform:scaleX(0)}.menu-toggle[aria-expanded="true"] span:nth-child(3){top:23px;transform:rotate(-45deg)}.mobile-menu{position:fixed;z-index:99;inset:0;display:none;width:100%;height:100vh;height:100dvh;overflow-y:auto;overscroll-behavior:contain;color:var(--ink);background:var(--blue-50);clip-path:circle(0 at calc(100% - 47px) 37px);pointer-events:none;visibility:hidden;transition:clip-path .78s var(--ease),visibility .78s}.mobile-menu.is-open{clip-path:circle(150vmax at calc(100% - 47px) 37px);pointer-events:auto;visibility:visible}.mobile-menu__inner{display:flex;width:min(100% - 48px,620px);min-height:100%;margin-inline:auto;padding:calc(var(--nav-height) + 52px) 0 max(34px,env(safe-area-inset-bottom));flex-direction:column}.mobile-menu__links{display:grid;gap:3px}.mobile-menu__links a{display:flex;align-items:center;justify-content:space-between;padding:15px 0;border-bottom:1px solid var(--blue-200);font-family:"Plus Jakarta Sans",Arial,sans-serif;font-size:clamp(1.45rem,7vw,2.15rem);font-weight:600;letter-spacing:-.04em;opacity:0;transform:translateY(18px);transition:opacity .4s var(--ease),transform .4s var(--ease)}.mobile-menu.is-open .mobile-menu__links a{opacity:1;transform:none}.mobile-menu.is-open .mobile-menu__links a:nth-child(1){transition-delay:.19s}.mobile-menu.is-open .mobile-menu__links a:nth-child(2){transition-delay:.24s}.mobile-menu.is-open .mobile-menu__links a:nth-child(3){transition-delay:.29s}.mobile-menu.is-open .mobile-menu__links a:nth-child(4){transition-delay:.34s}.mobile-menu.is-open .mobile-menu__links a:nth-child(5){transition-delay:.39s}.mobile-menu.is-open .mobile-menu__links a:nth-child(6){transition-delay:.44s}.mobile-menu__links svg{width:20px;height:20px;color:var(--blue-600)}.mobile-menu__bottom{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-top:auto;padding-top:40px;opacity:0;transform:translateY(14px);transition:opacity .4s .48s var(--ease),transform .4s .48s var(--ease)}.mobile-menu.is-open .mobile-menu__bottom{opacity:1;transform:none}.mobile-menu__bottom p{max-width:210px;margin:0;font-size:.85rem}.price-hero{position:relative;padding:calc(var(--nav-height) + 30px) 0 62px;overflow:hidden;background:var(--blue-50)}.price-hero::before{content:"";position:absolute;top:120px;right:-170px;width:360px;height:360px;border:58px solid rgba(169,209,231,.23);border-radius:50%}.breadcrumb{display:flex;align-items:center;gap:11px;margin-bottom:42px;color:var(--ink-soft);font-size:.72rem;font-weight:650}.breadcrumb a{color:var(--blue-700)}.breadcrumb svg{width:13px;height:13px;color:var(--blue-400)}.price-hero__grid{position:relative;display:grid;grid-template-columns:minmax(0,1.14fr) minmax(330px,.72fr);align-items:center;gap:clamp(48px,8vw,105px)}.price-hero__content{max-width:710px}.price-hero h1{max-width:700px;margin:0 0 22px;font-size:clamp(3rem,5.2vw,4.7rem);font-weight:600;letter-spacing:-.06em;line-height:.98}.price-hero h1 em{color:var(--blue-700);font-style:normal}.price-hero__copy{max-width:590px;margin-bottom:27px;font-size:1rem;line-height:1.65}.price-hero__actions{display:flex;flex-wrap:wrap;gap:12px}.price-hero__visual{position:relative;height:330px}.price-hero__visual img{width:100%;height:100%;border-radius:110px 24px 24px 24px;box-shadow:var(--shadow-md);object-position:center 43%}.price-hero__note{position:absolute;right:-15px;bottom:18px;display:flex;width:190px;align-items:center;gap:12px;padding:15px;border-radius:18px;color:var(--ink);background:var(--beige);box-shadow:var(--shadow-sm)}.price-hero__note .round-icon{width:38px;height:38px;flex:0 0 auto;border-radius:50%;color:var(--white);background:var(--blue-800)}.price-hero__note svg{width:18px;height:18px}.price-hero__note span{font-size:.68rem;font-weight:700;line-height:1.35}.price-jumps{position:relative;z-index:2;display:grid;grid-template-columns:repeat(5,1fr);margin-top:42px;overflow:hidden;border:1px solid var(--blue-200);border-radius:18px;background:rgba(255,255,255,.8)}.price-jumps a{padding:15px 12px;border-left:1px solid var(--blue-200);color:var(--blue-800);font-size:.72rem;font-weight:750;text-align:center;transition:background .25s}.price-jumps a:first-child{border-left:0}.price-jumps a:hover{background:var(--white)}.booking-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.booking-card{position:relative;display:flex;min-height:310px;padding:34px;border:1px solid var(--blue-200);border-radius:var(--radius-md);flex-direction:column;overflow:hidden;background:var(--white);box-shadow:var(--shadow-sm)}.booking-card:nth-child(2){background:var(--blue-50)}.booking-card__icon{display:grid;width:52px;height:52px;margin-bottom:34px;place-items:center;border-radius:50%;color:var(--blue-700);background:var(--blue-100)}.booking-card__icon svg{width:23px;height:23px}.booking-card h3{margin-bottom:10px;font-size:1.55rem;font-weight:650}.booking-card p{max-width:470px;margin-bottom:25px;font-size:.81rem}.booking-card__price{display:flex;align-items:flex-end;gap:14px;margin-top:auto;padding:14px 16px;border-radius:16px;color:var(--blue-800);background:var(--blue-50)}.booking-card:nth-child(2) .booking-card__price{background:var(--white)}.booking-card__price strong{font-family:"Plus Jakarta Sans",Arial,sans-serif;font-size:2.65rem;letter-spacing:-.06em;line-height:1}.booking-card__price span{padding-bottom:5px;font-size:.71rem;font-weight:700;line-height:1.35;white-space:nowrap}.booking-card__minimum{position:absolute;top:25px;right:25px;padding:7px 11px;border-radius:100px;color:var(--green);background:#e6f3ec;font-size:.64rem;font-weight:800}.hourly-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.ra