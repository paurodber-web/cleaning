              <div class="service-options">
                <div class="service-radio">
                  <input type="radio" name="service" id="serviceStandard" value="standard" checked>
                  <label for="serviceStandard"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="1.6">
                      <path d="M3 11.5 12 4l9 7.5" />
                      <path d="M5.5 10v10h13V10M9 20v-5h6v5" />
                    </svg>Standard clean</label>
                </div>
                <div class="service-radio">
                  <input type="radio" name="service" id="serviceDeep" value="deep">
                  <label for="serviceDeep"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                      stroke-width="1.6">
                      <path d="m12 3 1.3 3.7L17 8l-3.7 1.3L12 13l-1.3-3.7L7 8l3.7-1.3L12 3Z" />
                      <path d="m18.5 13 .8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2Z" />
                      <path d="M5.5 13 6.7 16l2.8 1-2.8 1L5.5 21l-1.2-3-2.8-1 2.8-1 1.2-3Z" />
                    </svg>Deep clean</label>
                </div>
                <div class="service-radio">
                  <input type="radio" name="service" id="serviceLease" value="lease">
                  <label for="serviceLease"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="1.6">
                      <circle cx="8" cy="15" r="3" />
                      <path d="m10.2 12.8 7.3-7.3 2 2-1.4 1.4 1.4 1.4-2 2-1.4-1.4-3.9 3.9" />
                    </svg>End of lease</label>
                </div>
                <div class="service-radio">
                  <input type="radio" name="service" id="serviceMove" value="move">
                  <label for="serviceMove"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                      stroke-width="1.6">
                      <path d="M4 8.5 12 3l8 5.5V20H4V8.5Z" />
                      <path d="M9 20v-6h6v6M17 4v-2" />
                    </svg>Move in</label>
                </div>
                <div class="service-radio">
                  <input type="radio" name="service" id="serviceHourly" value="hourly">
                  <label for="serviceHourly"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="1.6">
                      <circle cx="12" cy="12" r="9" />
                      <path d="M12 7v5l3.5 2" />
                    </svg>Hourly clean</label>
                </div>
              </div>
            </fieldset>

            <fieldset class="calc-block">
              <legend class="calc-legend"><span>2. Tell us about the clean</span><small id="propertyHint">Your home
                  size</small></legend>
              <div class="property-controls" id="propertyControls">
                <div class="stepper-row" id="bedroomRow">
                  <span class="stepper-row__label"><strong>Bedrooms</strong><small>From 1 to 6</small></span>
                  <span class="stepper" data-stepper="bedrooms">
