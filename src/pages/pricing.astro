                      minimum</small></span>
                  <span class="stepper" data-stepper="hours">
                    <button type="button" data-action="minus" aria-label="Remove half an hour">&#8722;</button>
                    <output id="hoursOutput" aria-live="polite">2</output>
                    <button type="button" data-action="plus" aria-label="Add half an hour">+</button>
                  </span>
                </div>
              </div>
            </fieldset>

            <fieldset class="calc-block">
              <legend class="calc-legend"><span>3. How often?</span><small>Save automatically</small></legend>
              <div class="frequency-options">
                <div class="frequency-option"><input type="radio" name="frequency" id="freqOnce" value="once"
                    checked><label for="freqOnce">One-off<span>No contract</span></label></div>
                <div class="frequency-option"><input type="radio" name="frequency" id="freqWeekly" value="weekly"><label
