          : state.bedrooms + " bedroom" + (state.bedrooms === 1 ? "" : "s") + " · " + frequency.name;
        document.getElementById("summaryExtras").replaceChildren(...selectedExtras.map((item) => {
          const row = document.createElement("div");
          row.className = "summary-extra";
          const label = document.createElement("span");
          const price = document.createElement("strong");
          label.textContent = item.name + (item.showQuantity ? " × " + item.quantity : "");
          price.textContent = item.includedInHours ? "Uses booked time" : money(item.linePrice);
          row.append(label, price);
          return row;
        }));
        const discountRow = document.getElementById("summaryDiscountRow");
        discountRow.hidden = discount === 0;
        document.getElementById("summaryDiscountLabel").textContent = "Recurring saving (" + Math.round(frequency.discount * 100) + "%)";
        document.getElementById("summaryDiscount").textContent = "−" + money(discount);
        document.getElementById("bookingLink").href = "/booking?" + new URLSearchParams({ service: serviceKey, frequency: frequencyKey, estimate: String(total) });
      }

      form.addEventListener("submit", (event) => event.preventDefault());
      form.addEventListener("change", (event) => {
        const scrollTop = window.scrollY;
        if (event.target.name === "service") updateServiceUI();
        calculatePrice();
      });
      updateServiceUI();
      calculatePrice();
      document.querySelectorAll(".faq-question").forEach(button=>button.addEventListener("click",()=>{const item=button.closest(".faq-item"),open=button.getAttribute("aria-expanded")!=="true";document.querySelectorAll(".faq-item").forEach(other=>{other.classList.remove("is-open");other.querySelector(".faq-question").setAttribute("aria-expanded","false")});if(open){item.classList.add("is-open");button.setAttribute("aria-expanded","true")}}));
      (document.getElementById("currentYear") || document.getElementById("year")).textContent=new Date().getFullYear();
    })();

  // Scroll progress bar logic
  (function() {
    const progress = document.getElementById("readingProgress");
    if (progress) {
      const updateProgress = () => {
        const scrolled = window.scrollY;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const pct = maxScroll > 0 ? (scrolled / maxScroll) * 100 : 0;
        progress.style.width = Math.min(100, Math.max(0, pct)) + "%";
      };
      updateProgress();
      window.addEventListener("scroll", updateProgress, { passive: true });
    }
  })();

</script>`;
