    (()=>{"use strict";
      const header=document.getElementById("siteHeader"),menuToggle=document.getElementById("menuToggle"),mobileMenu=document.getElementById("mobileMenu"),mobileLinks=[...mobileMenu.querySelectorAll("a")];let lastFocused=null;
      const updateHeader=()=>header.classList.toggle("is-scrolled",scrollY>24);updateHeader();addEventListener("scroll",updateHeader,{passive:true});
      const setMenu=open=>{menuToggle.setAttribute("aria-expanded",String(open));menuToggle.setAttribute("aria-label",open?"Close menu":"Open menu");mobileMenu.setAttribute("aria-hidden",String(!open));mobileMenu.classList.toggle("is-open",open);header.classList.toggle("menu-active",open);document.body.classList.toggle("menu-open",open);if(open){lastFocused=document.activeElement;setTimeout(()=>{if(menuToggle.getAttribute("aria-expanded")==="true")mobileLinks[0]?.focus()},350)}else if(lastFocused instanceof HTMLElement)lastFocused.focus({preventScroll:true})};
      menuToggle.addEventListener("click",()=>setMenu(menuToggle.getAttribute("aria-expanded")!=="true"));mobileLinks.forEach(a=>a.addEventListener("click",()=>setMenu(false)));document.addEventListener("keydown",e=>{if(e.key==="Escape"&&menuToggle.getAttribute("aria-expanded")==="true")setMenu(false);if(e.key!=="Tab"||menuToggle.getAttribute("aria-expanded")!=="true")return;const f=[menuToggle,...mobileMenu.querySelectorAll("a,button,input,[tabindex]:not([tabindex='-1'])")],first=f[0],last=f[f.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}});matchMedia("(min-width:821px)").addEventListener?.("change",e=>{if(e.matches)setMenu(false)});
      const reveals=document.querySelectorAll(".reveal");if("IntersectionObserver"in window&&!matchMedia("(prefers-reduced-motion:reduce)").matches){const o=new IntersectionObserver((es,ob)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("is-visible");ob.unobserve(e.target)}}),{threshold:.08,rootMargin:"0px 0px -30px"});reveals.forEach(x=>o.observe(x))}else reveals.forEach(x=>x.classList.add("is-visible"));

      const services = {
        standard: { name: "Standard clean", prices: [155, 175, 195, 235, 285, 315] },
        deep: { name: "Deep clean", prices: [215, 245, 275, 315, 375, 415] },
        lease: { name: "End of lease clean", prices: [410, 440, 500, 570, 670, 710] },
        move: { name: "Move in clean", prices: [410, 440, 500, 570, 670, 710] },
        hourly: { name: "Hourly clean", rate: 60 }
      };
      const frequencies = {
        once: { name: "One-off", discount: 0 },
        weekly: { name: "Weekly", discount: .10 },
        fortnightly: { name: "Fortnightly", discount: .10 },
        three: { name: "Every 3 weeks", discount: .05 },
        four: { name: "Every 4 weeks", discount: .05 },
        monthly: { name: "Every 4 weeks", discount: .05 }
      };
      const extraConfig = ${calculatorExtraConfigJson};
      const state = {
        bedrooms: 1,
        hours: 2,
        ...Object.fromEntries(Object.entries(extraConfig).filter(([, item]) => item.quantity).map(([key, item]) => [key, item.quantity.min]))
      };
      const limits = {
        bedrooms: [1, 6, 1],
        hours: [2, 12, .5],
        ...Object.fromEntries(Object.entries(extraConfig).filter(([, item]) => item.quantity).map(([key, item]) => [key, [item.quantity.min, item.quantity.max, item.quantity.step]]))
      };
      const form = document.getElementById("priceForm");
      const bedroomRow = document.getElementById("bedroomRow");
      const hoursRow = document.getElementById("hoursRow");
      const propertyHint = document.getElementById("propertyHint");
      const frequencyInputs = [...form.querySelectorAll("input[name='frequency']")];
      const notice = document.getElementById("frequencyNotice");
      const extraOptions = [...form.querySelectorAll(".extra-option")];
      const hourlyExtrasNotice = document.createElement("p");
      hourlyExtrasNotice.className = "hourly-extras-notice";
      hourlyExtrasNotice.id = "hourlyExtrasNotice";
      hourlyExtrasNotice.setAttribute("role", "status");
      hourlyExtrasNotice.setAttribute("aria-live", "polite");
      hourlyExtrasNotice.innerHTML = ${hourlyExtrasNoticeJson};
      document.getElementById("extrasGrid").after(hourlyExtrasNotice);
      const extraLabels = new Map(extraOptions.map((option) => [option.dataset.extra, option.querySelector("small").textContent]));
      const money = (amount) => new Intl.NumberFormat("en-AU", { style: "currency", currency: "AUD", minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(amount);
      const activeService = () => form.querySelector("input[name='service']:checked").value;
      const activeFrequency = () => form.querySelector("input[name='frequency']:checked").value;
      const activeBand = (item) => item.bands && item.bands.find((band) => state.bedrooms >= band.minBedrooms && state.bedrooms <= band.maxBedrooms);
      const unitPrice = (item) => {
        const band = activeBand(item);
        return band ? band.price : item.price;
      };
      const defaultExtraLabel = (key) => {
        const item = extraConfig[key];
        const band = activeBand(item);
        return band ? money(band.price).replace(".00", "") : extraLabels.get(key);
      };

      const syncStepper = (name) => {
        document.querySelectorAll('[data-stepper="' + name + '"]').forEach((stepper) => {
          const output = stepper.querySelector("output");
          const [min, max] = limits[name];
          output.textContent = Number.isInteger(state[name]) ? state[name] : state[name].toFixed(1);
          stepper.querySelector("[data-action='minus']").disabled = state[name] <= min;
          stepper.querySelector("[data-action='plus']").disabled = state[name] >= max;
        });
      };
      document.querySelectorAll("[data-stepper]").forEach((stepper) => {
        const name = stepper.dataset.stepper;
        stepper.addEventListener("click", (event) => {
          const button = event.target.closest("button");
          if (!button) return;
          const [min, max, increment] = limits[name];
          state[name] = Math.min(max, Math.max(min, state[name] + (button.dataset.action === "plus" ? increment : -increment)));
          syncStepper(name);
          calculatePrice();
        });
        syncStepper(name);
      });

      const setIncludedExtra = (key, included) => {
        const option = form.querySelector('[data-extra="' + key + '"]');
        if (!option) return;
        const input = option.querySelector("input");
        const priceText = option.querySelector("small");
        option.classList.toggle("is-included", included);
        input.disabled = included;
        if (included) {
          input.checked = false;
          priceText.textContent = "Included in service";
          priceText.classList.add("included-label");
        } else {
          priceText.textContent = defaultExtraLabel(key);
          priceText.classList.remove("included-label");
        }
      };

      const updateExtraLabels = (isHourly) => {
        hourlyExtrasNotice.classList.toggle("is-visible", isHourly);
        extraOptions.forEach((option) => {
          const input = option.querySelector("input");
          if (input.disabled) return;
          option.querySelector("small").textContent = isHourly
            ? "Included in booked hours"
            : defaultExtraLabel(option.dataset.extra);
        });
      };

      const updateServiceUI = () => {
        const service = activeService();
        const isHourly = service === "hourly";
        const canRepeat = service === "standard" || service === "deep" || service === "hourly";
        bedroomRow.hidden = isHourly;
        hoursRow.hidden = !isHourly;
        document.getElementById("propertyControls").classList.toggle("is-hourly", isHourly);

        propertyHint.textContent = isHourly ? "Choose total time" : "Your home size";
        frequencyInputs.forEach((input) => {
          input.disabled = !canRepeat && input.value !== "once";
        });
        if (!canRepeat && activeFrequency() !== "once") {
          document.getElementById("freqOnce").checked = true;
        }
        notice.classList.toggle("is-visible", !canRepeat);
        const cabinetsIncluded = service === "lease" || service === "move";
        setIncludedExtra("oven", cabinetsIncluded);
        setIncludedExtra("kitchenCabinets", cabinetsIncluded);
        setIncludedExtra("otherCabinets", cabinetsIncluded);
        updateExtraLabels(isHourly);
      };

      function calculatePrice() {
        const serviceKey = activeService();
        const frequencyKey = activeFrequency();
        const service = services[serviceKey];
        const frequency = frequencies[frequencyKey];
        const basePrice = serviceKey === "hourly"
          ? service.rate * state.hours
          : service.prices[state.bedrooms - 1];
        updateExtraLabels(serviceKey === "hourly");
        let extraTotal = 0;
        const selectedExtras = [];
        extraOptions.forEach((option) => {
          const input = option.querySelector("input");
          if (!input.checked || input.disabled) return;
          const key = option.dataset.extra;
          const item = extraConfig[key];
          const quantity = item.quantity ? state[key] : 1;
          const linePrice = serviceKey === "hourly" ? 0 : unitPrice(item) * quantity;
          extraTotal += linePrice;
          selectedExtras.push({
            name: item.name,
            quantity,
            linePrice,
            showQuantity: Boolean(item.quantity),
            includedInHours: serviceKey === "hourly"
          });
        });
        const eligible = serviceKey === "standard" || serviceKey === "deep" || serviceKey === "hourly";
        const discount = eligible ? Math.round((basePrice * frequency.discount + Number.EPSILON) * 100) / 100 : 0;
        const total = Math.round((basePrice + extraTotal - discount + Number.EPSILON) * 100) / 100;
        document.getElementById("summaryService").textContent = service.name;
        document.getElementById("summaryBase").textContent = money(basePrice);
        document.getElementById("summaryTotal").textContent = money(total);
        document.getElementById("summaryProperty").textContent = serviceKey === "hourly"
